# ClausePilot Environment Variables Template
# Copy to .env and fill in your values

# ── Application ──
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Upload Limits ──
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=./uploads

# ── Database ──
DATABASE_PATH=./clausepilot.db

# ── Groq LLM ──
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── Vector Store & Embeddings ──
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Comparison Bounding Settings ──
COMPARISON_TOP_K=8
COMPARISON_MAX_CONTEXT_CHARS=12000
COMPARISON_MIN_RETRIEVAL_SCORE=0.2
